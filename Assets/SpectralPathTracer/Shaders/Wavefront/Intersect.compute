/**
 * <summary>
 * Finds the nearest hit for every queued path's ray.
 * </summary>
 */

#pragma kernel Intersect

#include "../Include/Rays.hlsl"
#include "../Include/SceneData.hlsl"

uint _ObjectCount;
uint _QueueInOffset;
StructuredBuffer<GpuRay> _Rays;
StructuredBuffer<uint> _QueueIn;
ByteAddressBuffer _Counters;
RWStructuredBuffer<GpuHit> _Hits;
StructuredBuffer<GpuObject> _Objects;

/**
 * <summary>
 * Finds where each queued path's ray hits the scene and records it in the hit buffer.
 * </summary>
 */
[numthreads(64, 1, 1)]
void Intersect(uint3 id : SV_DispatchThreadID)
{
    // the dispatch rounds up to whole groups, so extra threads exit
    if (id.x >= _Counters.Load(_QueueInOffset))
        return;

    uint slot = _QueueIn[id.x];
    GpuRay ray = LoadRay(_Rays, slot);

    GpuHit hit;
    hit.T = 0.0f;
    hit.Hit = 0u;
    hit.ObjectIndex = -1;

    // keep the nearest hit across every object; with no objects the loop never runs and the ray misses
    for (uint i = 0; i < _ObjectCount; i++)
    {
        float t;
        bool hitObject = IntersectObject(LoadObject(_Objects, i), ray.Origin, ray.Direction, 0.0f, t);

        if (hitObject && (hit.Hit == 0u || t < hit.T))
        {
            hit.T = t;
            hit.Hit = 1u;
            hit.ObjectIndex = (int)i;
        }
    }

    StoreHit(_Hits, slot, hit);
}