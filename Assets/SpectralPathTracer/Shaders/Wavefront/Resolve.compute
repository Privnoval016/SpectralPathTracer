/**
 * <summary>
 * Adds every path's radiance to its pixel's running sum.
 * </summary>
 */

#pragma kernel Resolve

#include "../Include/PathState.hlsl"

uint _RayCount;
uint _SampleCount;
StructuredBuffer<GpuPathState> _Paths;
RWStructuredBuffer<float4> _Accumulation;

/**
 * <summary>
 * Adds each path's gathered radiance to its pixel's running sum.
 * </summary>
 */
[numthreads(64, 1, 1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _RayCount)
        return;

    GpuPathState path = LoadPath(_Paths, id.x);
    float3 radiance = path.Radiance.rgb;

    // the first sample after a reset replaces the old sum
    float3 sum = _SampleCount == 0u ? radiance : _Accumulation[path.PixelIndex].rgb + radiance;
    _Accumulation[path.PixelIndex] = float4(sum, 1.0f);
}