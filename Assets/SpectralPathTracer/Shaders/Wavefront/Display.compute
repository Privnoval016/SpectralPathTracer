/**
 * <summary>
 * Averages the accumulated sums, then applies exposure and a clamp for the screen.
 * </summary>
 */

#pragma kernel Display

#include "../Include/GpuData.hlsl"
#include "../Include/Spectrum/Cie.hlsl"

uint2 _Resolution;
StructuredBuffer<float4> _Accumulation;
StructuredBuffer<float4> _SpectralAccumulation; // the second image in split screen
RWTexture2D<float4> _Display;

/**
 * <summary>
 * The color of one wavelength at equal power, for the column a pixel is in.
 * </summary>
 * <param name="column">The pixel's column.</param>
 * <returns>The wavelength's linear sRGB color, pulled into the gamut.</returns>
 */
float3 SpectrumStrip(uint column)
{
    float lambda = lerp(380.0f, 780.0f, (column + 0.5f) / _Resolution.x); // the visible range across the image
    float3 rgb = XyzToLinearSrgb(MatchingFunctions(lambda));

    // pure wavelengths lie outside sRGB, so add white until no channel is negative
    rgb -= min(0.0f, min(rgb.r, min(rgb.g, rgb.b)));


    return rgb;
}

/**
 * <summary>
 * Displays the radiance buffer into the output, applying exposure if requested.
 * </summary>
 */
[numthreads(8, 8, 1)] // 2D dispatch
void Display(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _Resolution))
        return;

    uint index = id.x + id.y * _Resolution.x;
    float column = (id.x + 0.5f) / _Resolution.x;
    float4 sum = _Accumulation[index];
    bool xyz = _AccumulatesXyz != 0u;
    bool spectralSide = _SplitScreen == 0u; // without split screen the locked wavelength is only set in spectral mode

    // right of the divider shows the spectral image, whose sums are XYZ unless an aov is showing or the wavelength is locked
    if (_SplitScreen != 0u && column >= _SplitPosition)
    {
        sum = _SpectralAccumulation[index];
        xyz = _Aov == AOV_NONE && _LockedWavelength == 0.0f;
        spectralSide = true;
    }

    float3 color = sum.w > 0.0f ? sum.rgb / sum.w : float3(0.0f, 0.0f, 0.0f); // the buffer holds sums, so divide by the count

    // spectral mode sums XYZ, which becomes screen color only after averaging
    if (xyz)
        color = XyzToLinearSrgb(color);

    // a locked image is radiance at one wavelength, labeled with that wavelength's hue
    if (spectralSide && _LockedWavelength > 0.0f && _Aov == AOV_NONE)
        color *= WavelengthTint(_LockedWavelength);
    if (_ShowGrayRamp != 0u)
    {
        color = ((id.x + 0.5f) / _Resolution.x).xxx; // linear ramp
    }
    else
    {
        if (_ShowSpectrumStrip != 0u)
            color = SpectrumStrip(id.x); // one wavelength per column, at equal power

        if (_ApplyExposure != 0u)
            color *= _ExposureScale;

        // a one pixel white line marks the divider, in the column it falls in
        if (_SplitScreen != 0u && id.x == min((uint)(_SplitPosition * _Resolution.x), _Resolution.x - 1u))
            color = 1.0f;
    }

    // srgb encoding done with the blit
    _Display[id.xy] = float4(saturate(color), 1.0f);
}