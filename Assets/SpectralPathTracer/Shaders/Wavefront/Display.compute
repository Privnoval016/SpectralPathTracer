/**
 * <summary>
 * Averages the accumulated sums, then applies exposure and a clamp for the screen.
 * </summary>
 */

#pragma kernel Display

#include "../Include/GpuData.hlsl"

uint2 _Resolution;
StructuredBuffer<float4> _Accumulation;
RWTexture2D<float4> _Display;

/**
 * <summary>
 * Displays the radiance buffer into the output, applying exposure if requested.
 * </summary>
 */
[numthreads(8, 8, 1)] // 2D dispatch
void Display(uint3 id : SV_DispatchThreadID)
{
    if (any(id.xy >= _Resolution))
        return;

    float4 sum = _Accumulation[id.x + id.y * _Resolution.x];
    float3 color = sum.w > 0.0f ? sum.rgb / sum.w : float3(0.0f, 0.0f, 0.0f); // the buffer holds sums, so divide by the count
    if (_ShowGrayRamp != 0u)
    {
        color = ((id.x + 0.5f) / _Resolution.x).xxx; // linear ramp
    }
    else if (_ApplyExposure != 0u)
    {
        color *= _ExposureScale;
    }

    // srgb encoding done with the blit
    _Display[id.xy] = float4(saturate(color), 1.0f);
}