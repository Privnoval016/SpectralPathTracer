/**
 * <summary>
 * Starts one path per slot in a wave with its camera ray, its state and its place in the first queue.
 * </summary>
 */

#pragma kernel Generate
#pragma multi_compile_local _ SPECTRAL

#include "../Include/GpuData.hlsl"
#include "../Include/Camera.hlsl"
#include "../Include/Paths/Rays.hlsl"
#include "../Include/Paths/PathState.hlsl"
#include "../Include/Spectrum/SampledSpectrum.hlsl"
#include "../Include/Sampling/Sampler.hlsl"
#include "../Include/Paths/Queues.hlsl"

uint2 _Resolution;
uint _WaveStart;
uint _RayCount;
uint _SampleIndex;
RWStructuredBuffer<GpuRay> _Rays;
RWStructuredBuffer<GpuPathState> _Paths;
RWStructuredBuffer<uint> _QueueOut;
RWByteAddressBuffer _Counters;
RWByteAddressBuffer _Args;

/**
 * <summary>
 * Writes one camera ray per path slot in this wave into the ray buffer and starts each slot's path.
 * </summary>
 */
[numthreads(64, 1, 1)] // 1D dispatch, one thread per path slot
void Generate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _RayCount)
        return;

    // a wave's slots cover a run of consecutive pixels
    uint pixelIndex = _WaveStart + id.x;
    int2 pixel = int2(pixelIndex % _Resolution.x, pixelIndex / _Resolution.x);

    // a new spot in the pixel each sample anti-aliases edges
    float2 jitter = float2(0.5f, 0.5f);
    if (_PixelJitter != 0u)
    {
        uint2 outputPixel = OutputPixel(pixel);
        jitter = float2(SampleUniform(outputPixel, _SampleIndex, DIMENSION_PIXEL_JITTER_X),
                        SampleUniform(outputPixel, _SampleIndex, DIMENSION_PIXEL_JITTER_Y));
    }

    float2 uv = (float2(pixel) + jitter) / float2(_Resolution);

    GpuRay ray;
    ray.Origin = CameraRayOrigin();
    ray.Direction = CameraRayDirection(uv * 2.0f - 1.0f);
    ray.Pixel = pixel;

    StoreRay(_Rays, id.x, ray); // rays are stored row after row

    // nothing gathered yet
    GpuPathState path = (GpuPathState)0; // every reserved field starts at zero
    path.Throughput = LaneMask(ALL_LANES); // full strength in every lane in use
    path.PixelIndex = pixelIndex;
    path.Flags = PATHFLAGS_ACTIVE | ALL_LANES;
    path.SampleIndex = _SampleIndex;
    StoreWavelengths(path, SampleWavelengths());
    StorePath(_Paths, id.x, path);

    // every slot starts alive, so queue A holds the whole wave
    _QueueOut[id.x] = id.x;
    if (id.x == 0u)
    {
        _Counters.Store(0u, _RayCount);
        _Counters.Store(4u, 0u);
        _Args.Store3(0u, uint3(QueueGroups(_RayCount), 1u, 1u));
    }
}