/**
 * <summary>
 * Adds the light each queued path finds, then samples its next bounce or finishes it.
 * </summary>
 */

#pragma kernel Shade

#include "../Include/Sky.hlsl"
#include "../Include/Paths/Rays.hlsl"
#include "../Include/Paths/PathState.hlsl"
#include "../Include/SceneData.hlsl"
#include "../Include/Aov.hlsl"
#include "../Include/Paths/RayOffset.hlsl"
#include "../Include/Sampling/Sampler.hlsl"
#include "../Include/Sampling/Sampling.hlsl"

uint _Depth;
uint _MaxBounces;
uint _RussianRoulette;
RWStructuredBuffer<GpuRay> _Rays;
StructuredBuffer<GpuHit> _Hits;
StructuredBuffer<GpuObject> _Objects;
StructuredBuffer<GpuMaterial> _Materials;
RWStructuredBuffer<GpuPathState> _Paths;
StructuredBuffer<uint> _QueueIn;
RWStructuredBuffer<uint> _QueueOut;
RWByteAddressBuffer _Counters;
uint _QueueInOffset;
uint _QueueOutOffset;

/**
 * <summary>
 * Adds the light each path finds at its hit, then samples the path's next bounce or finishes it.
 * </summary>
 */
[numthreads(64, 1, 1)]
void Shade(uint3 id : SV_DispatchThreadID)
{
    // the dispatch rounds up to whole groups, so extra threads exit
    if (id.x >= _Counters.Load(_QueueInOffset))
        return;

    uint slot = _QueueIn[id.x];
    GpuPathState path = LoadPath(_Paths, slot);
    if (!IsActive(path))
        return;

    GpuRay ray = LoadRay(_Rays, slot);
    GpuHit hit = LoadHit(_Hits, slot);

    // rebuild the hit from the ray instead of storing it
    float3 position = float3(0.0f, 0.0f, 0.0f);
    float3 normal = float3(0.0f, 0.0f, 0.0f);
    bool frontFace = true;
    GpuMaterial material = (GpuMaterial)0;

    if (hit.Hit != 0u)
    {
        GpuObject hitObject = LoadObject(_Objects, hit.ObjectIndex);
        position = ray.Origin + hit.T * ray.Direction;
        normal = ObjectNormal(hitObject, position);
        frontFace = dot(normal, ray.Direction) < 0.0f;
        material = LoadMaterial(_Materials, hitObject.MaterialIndex);
    }

    if (_Depth == 0u && _Aov != AOV_NONE)
    {
        path.Radiance.rgb = AovColor(ray, hit, normal, frontFace);
        Finish(path);
    }
    else if (hit.Hit == 0u)
    {
        path.Radiance.rgb += path.Throughput.rgb * SkyRadiance(ray.Direction); // the sky is a light too
        Finish(path);
    }
    else
    {
        if (frontFace)
            path.Radiance.rgb += path.Throughput.rgb * material.Emission; // lights emit from their front only

        if (_Depth < _MaxBounces)
        {
            float3 facing = frontFace ? normal : -normal;
            uint2 pixel = OutputPixel(ray.Pixel);
            float2 u = float2(SampleUniform(pixel, _SampleIndex, BounceDimension(_Depth, SLOT_BSDF_U)),
                              SampleUniform(pixel, _SampleIndex, BounceDimension(_Depth, SLOT_BSDF_V)));

            path.Throughput.rgb *= material.Albedo; // f cos / pdf for a Lambertian surface is the albedo

            bool continues = any(path.Throughput.rgb > 0.0f);


            float largestLane = max(path.Throughput.r, max(path.Throughput.g, path.Throughput.b));
            
            if (continues && _RussianRoulette != 0u && _Depth >= 1u && largestLane < 1.0f)
            {
                continues = SampleUniform(pixel, _SampleIndex, BounceDimension(_Depth, SLOT_RUSSIAN_ROULETTE)) < largestLane;
                path.Throughput.rgb /= largestLane; // throughput scaling to be unbiased
            }

            if (continues)
            {
                ray.Origin = OffsetRayOrigin(position, facing);
                ray.Direction = LocalToWorld(SampleCosineHemisphere(u), facing);
                StoreRay(_Rays, slot, ray);

                // each thread gets its own slot, so the queue stays packed
                uint queuePosition;
                _Counters.InterlockedAdd(_QueueOutOffset, 1u, queuePosition);
                _QueueOut[queuePosition] = slot;
            }
            else
                Finish(path); // out of light, or stopped by roulette
        }
        else
            Finish(path);
    }

    StorePath(_Paths, slot, path);
}