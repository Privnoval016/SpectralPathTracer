#pragma kernel Shade

#include "../Include/Sky.hlsl"
#include "../Include/Rays.hlsl"
#include "../Include/SceneData.hlsl"
#include "../Include/Aov.hlsl"

uint _RayCount;
StructuredBuffer<GpuRay> _Rays;
StructuredBuffer<GpuHit> _Hits;
StructuredBuffer<GpuObject> _Objects;
StructuredBuffer<GpuMaterial> _Materials;
RWTexture2D<float4> _Output;

/**
 * <summary>
 * Turns each ray's hit into a color and writes it to the ray's pixel.
 * </summary>
 */
[numthreads(64, 1, 1)]
void Shade(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _RayCount)
        return;

    GpuRay ray = LoadRay(_Rays, id.x);
    GpuHit hit = LoadHit(_Hits, id.x);

    // rebuild the hit from the ray instead of storing it
    float3 normal = float3(0.0f, 0.0f, 0.0f);
    bool frontFace = true;
    float3 albedo = float3(0.0f, 0.0f, 0.0f);

    if (hit.Hit != 0u)
    {
        GpuObject hitObject = LoadObject(_Objects, hit.ObjectIndex);
        float3 position = ray.Origin + hit.T * ray.Direction;
        normal = ObjectNormal(hitObject, position);
        frontFace = dot(normal, ray.Direction) < 0.0f;
        albedo = LoadMaterial(_Materials, hitObject.MaterialIndex).Albedo;
    }

    float3 color;
    if (_Aov != AOV_NONE)
        color = AovColor(ray, hit, normal, frontFace);
    else
        color = hit.Hit != 0u ? albedo : SkyRadiance(ray.Direction);

    _Output[ray.Pixel] = float4(color, 1.0f);
}