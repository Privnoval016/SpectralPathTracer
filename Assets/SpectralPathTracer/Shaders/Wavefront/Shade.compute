/**
 * <summary>
 * Adds the light each queued path finds, then samples its next bounce or finishes it.
 * </summary>
 */

#pragma kernel Shade

#include "../Include/GpuData.hlsl"
#include "../Include/Sky.hlsl"
#include "../Include/Paths/Rays.hlsl"
#include "../Include/Paths/PathState.hlsl"
#include "../Include/Lanes.hlsl"
#include "../Include/Trace.hlsl"
#include "../Include/Aov.hlsl"
#include "../Include/Materials/Bsdf.hlsl"
#include "../Include/Paths/RayOffset.hlsl"
#include "../Include/Paths/RussianRoulette.hlsl"
#include "../Include/Paths/Queues.hlsl"
#include "../Include/Sampling/Sampler.hlsl"

uint _Depth;
RWStructuredBuffer<GpuRay> _Rays;
StructuredBuffer<GpuHit> _Hits;
RWStructuredBuffer<GpuPathState> _Paths;
StructuredBuffer<uint> _QueueIn;
RWStructuredBuffer<uint> _QueueOut;
RWByteAddressBuffer _Counters;
uint _QueueInOffset;
uint _QueueOutOffset;

/**
 * <summary>
 * Adds the light each path finds at its hit, then samples the path's next bounce or finishes it.
 * </summary>
 */
[numthreads(QUEUESIZES_GROUP_SIZE, 1, 1)]
void Shade(uint3 id : SV_DispatchThreadID)
{
    // the dispatch rounds up to whole groups, so extra threads exit
    if (id.x >= QueueCount(_Counters, _QueueInOffset))
        return;

    uint slot = _QueueIn[id.x];
    GpuPathState path = LoadPath(_Paths, slot);
    if (!IsActive(path))
        return;

    GpuRay ray = LoadRay(_Rays, slot);
    GpuHit hit = LoadHit(_Hits, slot);

    // rebuild the hit from the ray instead of storing it
    SurfaceHit surface = BuildSurfaceHit(ray, hit);

    if (_Depth == 0u && _Aov != AOV_NONE)
    {
        path.Radiance.rgb = AovColor(ray, hit, surface.Normal, surface.FrontFace);
        Finish(path);
    }
    else if (hit.Hit == 0u)
    {
        path.Radiance += path.Throughput * RgbToLanes(SkyRadiance(ray.Direction)); // the sky is a light too
        Finish(path);
    }
    else
    {
        if (surface.FrontFace)
            path.Radiance += path.Throughput * RgbToLanes(surface.Material.Emission); // lights emit from their front only

        if (_Depth < _MaxBounces)
        {
            uint2 pixel = OutputPixel(ray.Pixel);
            BsdfSample bsdf = SampleBsdf(surface.Material, surface.Facing, SampleBsdf2D(pixel, _Depth));
            path.Throughput *= bsdf.Weight;

            bool continues = any(path.Throughput > 0.0f);
            if (continues && _RussianRoulette != 0u && _Depth >= 1u)
                continues = SurvivesRoulette(path.Throughput, SampleUniform(pixel, _SampleIndex, BounceDimension(_Depth, SLOT_RUSSIAN_ROULETTE)));

            if (continues)
            {
                ray.Origin = OffsetRayOrigin(surface.Position, surface.Facing);
                ray.Direction = bsdf.Direction;
                StoreRay(_Rays, slot, ray);
                Enqueue(_QueueOut, _Counters, _QueueOutOffset, slot);
            }
            else
                Finish(path); // out of light, or stopped by roulette
        }
        else
            Finish(path);
    }

    StorePath(_Paths, slot, path);
}